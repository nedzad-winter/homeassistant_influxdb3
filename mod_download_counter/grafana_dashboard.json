{
  "__inputs": [
    {
      "name": "DS_INFLUXDB",
      "label": "InfluxDB",
      "type": "datasource",
      "pluginId": "influxdb",
      "pluginName": "InfluxDB"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "influxdb", "name": "InfluxDB", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "bargauge", "name": "Bar gauge", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" }
  ],
  "title": "Minecraft Mod Download Counter",
  "uid": "mod-download-counter",
  "description": "Tracks Modrinth and CurseForge download counts for create_photomovement",
  "tags": ["minecraft", "mods"],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "1h",
  "time": { "from": "now-30d", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "editable": true,
  "links": [],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total Downloads",
      "description": "Combined Modrinth + CurseForge",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "text": { "valueSize": 48 }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "query": "SELECT last(\"value\") FROM \"downloads\" WHERE \"entity_id\" = 'mod_create_photomovement_total' AND $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Modrinth Downloads",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "text": { "valueSize": 40 }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "query": "SELECT last(\"value\") FROM \"downloads\" WHERE \"entity_id\" = 'mod_create_photomovement_modrinth' AND $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "CurseForge Downloads",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "text": { "valueSize": 40 }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "orange", "value": null }]
          },
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "query": "SELECT last(\"value\") FROM \"downloads\" WHERE \"entity_id\" = 'mod_create_photomovement_curseforge' AND $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Download Counts Over Time",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 5 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true,
            "showPoints": "auto",
            "pointSize": 5
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Total" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } },
              { "id": "custom.lineWidth", "value": 3 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Modrinth" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "CurseForge" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "alias": "Total",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "query": "SELECT mean(\"value\") FROM \"downloads\" WHERE \"entity_id\" = 'mod_create_photomovement_total' AND $timeFilter GROUP BY time($__interval) fill(previous)",
          "rawQuery": true,
          "resultFormat": "time_series"
        },
        {
          "refId": "B",
          "alias": "Modrinth",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "query": "SELECT mean(\"value\") FROM \"downloads\" WHERE \"entity_id\" = 'mod_create_photomovement_modrinth' AND $timeFilter GROUP BY time($__interval) fill(previous)",
          "rawQuery": true,
          "resultFormat": "time_series"
        },
        {
          "refId": "C",
          "alias": "CurseForge",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "query": "SELECT mean(\"value\") FROM \"downloads\" WHERE \"entity_id\" = 'mod_create_photomovement_curseforge' AND $timeFilter GROUP BY time($__interval) fill(previous)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Per-Version Downloads — Modrinth",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "minVizWidth": 0,
        "minVizHeight": 10,
        "namePlacement": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "mod_create_photomovement_modrinth_(\\d)(\\d)(\\d)_(\\d)(\\d{2})(\\d)_(.+)",
            "renamePattern": "v$1.$2.$3 / $4.$5.$6 / $7"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "renameByName": {},
            "indexByName": {
              "Time": 0,
              "v0.3.3 / 1.21.1 / neoforge": 1,
              "v0.3.3 / 1.20.1 / forge_neoforge": 2,
              "v0.3.3 / 1.20.1 / fabric": 3,
              "v0.3.2 / 1.21.1 / neoforge": 4,
              "v0.3.2 / 1.20.1 / forge_neoforge": 5,
              "v0.3.2 / 1.20.1 / fabric": 6,
              "v0.3.1 / 1.21.1 / forge_neoforge": 7,
              "v0.3.1 / 1.20.1 / forge_neoforge": 8,
              "v0.3.1 / 1.20.1 / fabric": 9,
              "v0.3.0 / 1.21.1 / neoforge": 10,
              "v0.3.0 / 1.20.1 / forge_neoforge": 11,
              "v0.3.0 / 1.20.1 / fabric": 12
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "alias": "$tag_entity_id",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "query": "SELECT last(\"value\") FROM \"downloads\" WHERE \"entity_id\" =~ /^mod_create_photomovement_modrinth_.+/ AND $timeFilter GROUP BY \"entity_id\"",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Per-Version Downloads — CurseForge",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "minVizWidth": 0,
        "minVizHeight": 10,
        "namePlacement": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "orange", "value": null }]
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "mod_create_photomovement_curseforge_(\\d)(\\d)(\\d)_(\\d)(\\d{2})(\\d)_(.+)",
            "renamePattern": "v$1.$2.$3 / $4.$5.$6 / $7"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "renameByName": {},
            "indexByName": {
              "v0.3.3 / 1.21.1 / neoforge": 0,
              "v0.3.3 / 1.20.1 / forge_neoforge": 1,
              "v0.3.3 / 1.20.1 / fabric": 2,
              "v0.3.2 / 1.21.1 / neoforge": 3,
              "v0.3.2 / 1.20.1 / forge_neoforge": 4,
              "v0.3.2 / 1.20.1 / fabric": 5,
              "v0.3.1 / 1.21.1 / neoforge": 6,
              "v0.3.1 / 1.20.1 / forge_neoforge": 7,
              "v0.3.1 / 1.20.1 / fabric": 8,
              "v0.3.0 / 1.21.1 / neoforge": 9,
              "v0.3.0 / 1.20.1 / forge_neoforge": 10,
              "v0.3.0 / 1.20.1 / fabric": 11
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "alias": "$tag_entity_id",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "query": "SELECT last(\"value\") FROM \"downloads\" WHERE \"entity_id\" =~ /^mod_create_photomovement_curseforge_.+/ AND $timeFilter GROUP BY \"entity_id\"",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "All Version Sensors",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 25 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Downloads", "desc": true }],
        "cellHeight": "sm",
        "footer": { "show": false, "reducer": ["sum"], "countRows": false, "fields": "" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Downloads" },
            "properties": [
              { "id": "custom.width", "value": 140 },
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background", "mode": "gradient" }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 500 },
                    { "color": "red", "value": 2000 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "entity_id" },
            "properties": [{ "id": "custom.width", "value": 500 }]
          }
        ]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": { "valueLabel": "entity_id", "mode": "columns" }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "mod_create_photomovement_(modrinth|curseforge)_(\\d)(\\d)(\\d)_(\\d)(\\d{2})(\\d)_(.+)",
            "renamePattern": "$1 v$2.$3.$4 / $5.$6.$7 / $8"
          }
        },
        {
          "id": "reduce",
          "options": { "reducers": ["lastNotNull"], "labelsToFields": false }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": { "Field": "Sensor", "lastNotNull": "Downloads" }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "alias": "$tag_entity_id",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "query": "SELECT last(\"value\") FROM \"downloads\" WHERE \"entity_id\" =~ /^mod_create_photomovement_(modrinth|curseforge)_.+/ AND $timeFilter GROUP BY \"entity_id\"",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    }
  ]
}
